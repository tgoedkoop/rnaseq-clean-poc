/*
 * ==========================================================================
 *  nextflow.config
 * --------------------------------------------------------------------------
 *  Nextflow reads this file automatically when you launch the pipeline
 *  from this folder. It holds SETTINGS (parameters, software environment,
 *  reporting), while main.nf holds LOGIC. Keeping the two apart lets you
 *  change how a pipeline runs without touching what it does.
 * ==========================================================================
 */


// --------------------------------------------------------------------------
//  Pipeline metadata
// --------------------------------------------------------------------------
manifest {
    name            = 'rnaseq-clean-poc'
    description     = 'Proof-of-concept pipeline: clean and classify RNA-seq DE results'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    // Refuse to run on Nextflow versions older than the one this was written for
    nextflowVersion = '>=24.04.0'
}


// --------------------------------------------------------------------------
//  Default parameters (override any of them on the command line: --padj 0.01)
// --------------------------------------------------------------------------
params {
    input  = null        // Path to the DE results CSV (required)
    outdir = 'results'   // Where final outputs are published
    padj   = 0.05        // Adjusted p-value cutoff
    lfc    = 1           // Absolute log2 fold-change cutoff
}


// --------------------------------------------------------------------------
//  Docker
// --------------------------------------------------------------------------
docker {
    // Run every process inside the image named by its `container` directive.
    // Without this line, the `container` directive is ignored and the
    // script runs with whatever R is installed on the host.
    enabled    = true

    // Run the container as YOUR user rather than root, so files written
    // to work/ and results/ belong to you (this matters on Linux).
    // Single quotes stop Nextflow from interpreting the $; the shell
    // evaluates it when the container starts.
    runOptions = '-u $(id -u):$(id -g)'
}


// --------------------------------------------------------------------------
//  Execution reports: a record of what ran, where, and how long it took
// --------------------------------------------------------------------------
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}
